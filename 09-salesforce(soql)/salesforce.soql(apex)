// 2. ВЫПОЛНЕНИЕ SOQL-ЗАПРОСОВ

// Задача 1: Крупные активные и выигранные сделки
List<Opportunity> highValueOpps = [
    SELECT Id, Name, StageName, Amount, CloseDate
    FROM Opportunity
    WHERE StageName != 'Closed Lost' AND Amount > 50000
    ORDER BY Amount DESC
];

// Задача 2: Контакты и названия их компаний (Child-to-Parent)
List<Contact> contactsWithAccounts = [
    SELECT FirstName, LastName, Email, Account.Name, Account.Industry
    FROM Contact
];

// Задача 3: Компании и вложенный список их сделок (Parent-to-Child)
List<Account> accountsWithOpps = [
    SELECT Name, Industry, (SELECT Name, StageName, Amount FROM Opportunities)
    FROM Account
];

// Задача 4: Агрегация выручки по компаниям (> $100,000)
List<AggregateResult> topAccountsRevenue = [
    SELECT Account.Name accName, COUNT(Id) dealsCount, SUM(Amount) totalAmount
    FROM Opportunity
    GROUP BY Account.Name
    HAVING SUM(Amount) > 100000
];

// Задача 5: Компании с открытыми тикетами высокого приоритета (Semi-Join)
List<Account> urgentSupportAccounts = [
    SELECT Id, Name, Industry, Rating
    FROM Account
    WHERE Id IN (
        SELECT AccountId 
        FROM Case 
        WHERE Priority = 'High' AND Status != 'Closed'
    )
];
